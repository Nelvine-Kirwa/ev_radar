rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function myName() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name;
    }

    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    match /cars/{carId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /stations/{stationId} {
      allow read: if request.auth != null;

      allow update: if request.auth != null &&
        (
          request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['likeCount', 'likedBy'])
          ||
          isAdmin()
          ||
          (
            !('operatorId' in resource.data) &&
            request.resource.data.operatorId == request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['operatorId', 'status'])
          )
          ||
          (
            resource.data.operatorId == request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status'])
          )
        );

      allow create: if request.auth != null &&
        request.resource.data.operatorId == request.auth.uid &&
        request.resource.data.status == 'pending';

      allow delete: if false;
    }

    match /electricians/{electricianId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
      allow update: if isAdmin();
    }

    match /operator_applications/{docId} {
      allow create: if request.auth != null &&
        request.resource.data.uid == request.auth.uid;
      allow read: if (request.auth != null &&
        resource.data.uid == request.auth.uid) || isAdmin();
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /technician_applications/{docId} {
      allow create: if request.auth != null &&
        request.resource.data.uid == request.auth.uid;
      allow read: if (request.auth != null &&
        resource.data.uid == request.auth.uid) || isAdmin();
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /bookings/{docId} {
      // Read: owner, admin, assigned technician, OR any authed user
      // reading COMPLETED bookings (needed to compute technician counts).
      allow read: if request.auth != null &&
        (
          resource.data.userId == request.auth.uid
          || isAdmin()
          || (
            'electricianName' in resource.data &&
            resource.data.electricianName == myName()
          )
          || resource.data.status == 'COMPLETED'
        );

      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'SCHEDULED';

      allow update: if request.auth != null &&
        (
          (
            resource.data.userId == request.auth.uid &&
            request.resource.data.status == 'CANCELLED' &&
            request.resource.data.userId == resource.data.userId &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'updatedAt'])
          )
          ||
          (
            'electricianName' in resource.data &&
            resource.data.electricianName == myName() &&
            (
              (
                resource.data.status == 'SCHEDULED' &&
                request.resource.data.status == 'IN_PROGRESS'
              )
              ||
              (
                resource.data.status == 'IN_PROGRESS' &&
                request.resource.data.status == 'COMPLETED'
              )
            ) &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'completedAt'])
          )
        );

      allow delete: if false;
    }


    // NEW — technician ratings
    match /ratings/{ratingId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.raterId == request.auth.uid
        && request.resource.data.stars is int
        && request.resource.data.stars >= 1
        && request.resource.data.stars <= 5;
      allow delete: if false;
    }
    match /station_bookings/{bookingId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'CONFIRMED' &&
        request.resource.data.startTime is timestamp &&
        request.resource.data.endTime is timestamp &&
        request.resource.data.startTime < request.resource.data.endTime;
      allow update: if request.auth != null &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status']) &&
        (
          request.resource.data.status == 'CANCELLED' ||
          request.resource.data.status == 'EXPIRED'
        );
      allow delete: if false;
    }

    match /notifications/{notifId} {
      allow read: if request.auth != null &&
        resource.data.recipientId == request.auth.uid;

      allow create: if request.auth != null &&
        (
          (
            request.resource.data.recipientId == request.auth.uid &&
            request.resource.data.type in [
              'BOOKING_CONFIRMED',
              'OPERATOR_APPLICATION_SUBMITTED',
              'TECHNICIAN_APPLICATION_SUBMITTED',
              'APPLICATION_APPROVED',
              'APPLICATION_REJECTED'
            ]
          )
          ||
          (
            request.resource.data.recipientId != request.auth.uid &&
            (
              !('relatedBookingId' in request.resource.data) ||
              request.resource.data.relatedBookingId == null ||
              get(/databases/$(database)/documents/bookings/$(request.resource.data.relatedBookingId))
                  .data.userId == request.auth.uid ||
              (
                request.resource.data.type == 'INSTALLATION_COMPLETED' &&
                get(/databases/$(database)/documents/bookings/$(request.resource.data.relatedBookingId))
                    .data.electricianName == myName()
              )
            )
          )
        );

      allow update: if request.auth != null &&
        resource.data.recipientId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['read']);
      allow delete: if false;
    }
  }
}
